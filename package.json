{
  "name": "@thurstonsand/pi-permissions",
  "version": "0.12.5",
  "type": "module",
  "description": "Pi extension package for user, project, and package-level tool permission hooks",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thurstonsand/pi-permissions.git"
  },
  "homepage": "https://github.com/thurstonsand/pi-permissions#readme",
  "bugs": {
    "url": "https://github.com/thurstonsand/pi-permissions/issues"
  },
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "examples",
    "extensions",
    "skills",
    "src",
    "README.md",
    "CHANGELOG.md",
    "CONTEXT.md",
    "DEV.md",
    "AGENTS.md",
    "docs"
  ],
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "skills": [
      "./skills/create-permission"
    ]
  },
  "scripts": {
    "lint": "mise run lint",
    "format": "mise run format",
    "typecheck": "mise run typecheck",
    "test": "mise run test",
    "check": "mise run check"
  },
  "dependencies": {
    "jiti": "^2.6.1",
    "minimatch": "10.2.6",
    "tree-sitter-bash": "^0.25.1",
    "web-tree-sitter": "0.26.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@earendil-works/pi-agent-core": "^1.5.0",
    "@earendil-works/pi-ai": "^1.5.0",
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@earendil-works/pi-tui": "^1.5.0",
    "@types/node": "^22.20.5",
    "typebox": "1.3.27",
    "typescript": "^7.0.0",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=1.5.0",
    "@earendil-works/pi-ai": ">=1.5.0",
    "@earendil-works/pi-coding-agent": ">=1.5.0",
    "@earendil-works/pi-tui": ">=1.5.0",
    "typebox": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "allowScripts": {
    "protobufjs": false,
    "tree-sitter-bash": false,
    "@google/genai": false
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "node-addon-api": "8.9.1",
    "minimatch": "$minimatch"
  }
}
