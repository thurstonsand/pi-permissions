{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "customManagers:biomeVersions",
    ":configMigration",
    ":maintainLockFilesWeekly",
    ":disableRateLimiting",
    ":prImmediately",
    "abandonments:recommended",
    ":enableVulnerabilityAlertsWithAdditionalLabel(security)",
    "helpers:pinGitHubActionDigests"
  ],
  "dependencyDashboard": true,
  "timezone": "America/New_York",
  "labels": ["dependencies"],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)hk\\.pkl$/"],
      "matchStrings": [
        "package://github\\.com/jdx/hk/releases/download/v(?<currentValue>[^/]+)/hk@[^#]+#/(?<depType>Config|Builtins)\\.pkl"
      ],
      "depNameTemplate": "hk",
      "packageNameTemplate": "jdx/hk",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced",
      "extractVersionTemplate": "^v(?<version>.+)",
      "autoReplaceStringTemplate": "package://github.com/jdx/hk/releases/download/v{{{newValue}}}/hk@{{{newValue}}}#/{{{depType}}}.pkl"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": ["npm"],
      "groupName": "npm packages"
    },
    {
      "matchManagers": ["mise"],
      "groupName": "mise tools"
    },
    {
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["lockFileMaintenance"],
      "enabled": false
    },
    {
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["jdx/hk"],
      "groupName": "hk",
      "groupSlug": "hk"
    },
    {
      "description": "Pi always takes its latest release; the extension is verified against the Pi it runs on, so it skips the release-age gate.",
      "matchPackageNames": ["@earendil-works/**"],
      "minimumReleaseAge": null
    },
    {
      "description": "Pi updates raise the devDependency floors instead of only the lockfile. Scoped to devDependencies: the peers stay \"*\", as the rule below keeps them.",
      "matchPackageNames": ["@earendil-works/**"],
      "matchDepTypes": ["devDependencies"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Pinned to the version pi ships. Pi's extension loader aliases typebox to its own bundled copy, so our declaration only types what pi executes and must match it. It moves when pi moves, not on Renovate's schedule; the typebox pin test reports when that happens.",
      "matchManagers": ["npm"],
      "matchPackageNames": ["typebox"],
      "enabled": false
    },
    {
      "description": "@types/node describes the oldest Node the code must run on rather than the newest DefinitelyTyped release or the Node mise runs, so tsc rejects APIs that are not there. It follows the engines floor's major.",
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "<23"
    },
    {
      "description": "Pi's docs/packages.md has a package declare the packages Pi provides as peerDependencies at \"*\", so it loads in whichever Pi hosts it. Renovate leaves those peers alone; the devDependencies carry the Pi the package is built against.",
      "matchPackageNames": ["@earendil-works/**", "typebox"],
      "matchDepTypes": ["peerDependencies"],
      "enabled": false
    }
  ]
}
