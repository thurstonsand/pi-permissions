{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "customManagers:biomeVersions",
    ":configMigration",
    ":maintainLockFilesWeekly",
    "security:minimumReleaseAgeNpm",
    "abandonments:recommended",
    ":enableVulnerabilityAlertsWithAdditionalLabel(security)"
  ],
  "dependencyDashboard": true,
  "timezone": "America/New_York",
  "labels": ["dependencies"],
  "schedule": ["* * * * 1"],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": ["npm"],
      "groupName": "npm packages"
    },
    {
      "matchManagers": ["mise"],
      "groupName": "mise tools"
    },
    {
      "description": "Restricted registry lacks newer versions; remove once available",
      "matchPackageNames": ["node-addon-api", "web-tree-sitter"],
      "enabled": false
    },
    {
      "description": "Pinned to the version pi ships. Pi's extension loader aliases typebox to its own bundled copy, so our declaration only types what pi executes and must match it. It moves when pi moves, not on Renovate's schedule; the typebox pin test reports when that happens.",
      "matchManagers": ["npm"],
      "matchPackageNames": ["typebox"],
      "enabled": false
    }
  ]
}
